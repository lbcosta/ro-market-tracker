<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RO Market Tracker</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/htmx.min.js"></script>
  <script src="/static/app.js" defer></script>
  <script src="/static/watchlist.js" defer></script>
  <script src="/static/activity-bar.js" defer></script>
</head>
<body>
  <main class="page">
    <h1>RO Market Tracker</h1>
    <p class="subtitle">Preços do mercado de comércio do Ragnarok Online LATAM</p>

    <form class="search-form" hx-get="/web/search" hx-target="#results" hx-swap="innerHTML" hx-indicator="#search-spinner">
      <select name="server" aria-label="Servidor">
        <option value="NIDHOGG" selected>NIDHOGG</option>
        <option value="FREYA">FREYA</option>
      </select>
      <input type="text" name="item" placeholder="Nome do item" aria-label="Nome do item" required autofocus>
      <button type="submit" class="search-button" aria-label="Buscar">
        <span aria-hidden="true">🔍</span>
        <span id="search-spinner" class="htmx-indicator spinner" aria-hidden="true"></span>
      </button>
    </form>

    <div class="results-column">
      <div id="results"></div>
    </div>

    <aside class="watchlist-panel" aria-label="Watchlist">
      <div class="watchlist-header">
        <h2>Watchlist</h2>
        <div class="watchlist-timer" title="Tempo até a próxima checagem automática de preços">
          <span id="watchlist-countdown">--:--</span>
          <button type="button" id="watchlist-refresh-now" aria-label="Atualizar agora e reiniciar o cronômetro" title="Atualizar agora">↻</button>
        </div>
      </div>
      <ul id="watchlist-list" class="watchlist-list"></ul>
      <p id="watchlist-empty" class="empty">Nenhum item na watchlist.</p>
    </aside>
  </main>

  <div id="activity-bar" class="activity-bar" role="button" tabindex="0" aria-expanded="false" aria-label="Barra de atividades — clique para expandir ou recolher">
    <div class="activity-bar-body">
      <p>oi sou uma barra de atividades</p>
    </div>
    <div class="activity-bar-header">
      <span class="activity-bar-title">Atividade</span>
      <span class="activity-bar-icon" aria-hidden="true">▲</span>
    </div>
  </div>
</body>
</html>
