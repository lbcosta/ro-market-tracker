<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RO Market Tracker</title>
  <link rel="stylesheet" href="/static/style.css">
  <script>
    // Aplica a escolha manual de tema (ver theme.js) antes da primeira
    // pintura — sem isto, a página desenharia com o tema padrão por um
    // instante e só depois trocaria pro escolhido, um flash perceptível a
    // cada carregamento.
    (function () {
      try {
        var tema = localStorage.getItem("ro-market-tracker:theme");
        if (tema === "light" || tema === "dark") {
          document.documentElement.dataset.theme = tema;
        }
        // Pelo mesmo motivo: a watchlist expandida reorganiza o grid da
        // página inteira, e aplicá-la depois faria a tela saltar do layout
        // de duas colunas para o de uma a cada carregamento. Vai no <html>
        // porque a .page ainda não existe quando este script roda.
        //
        // Sem preferência salva, o padrão é expandida: um carregamento novo
        // da página sempre começa com #results vazio (nenhuma busca ainda
        // foi enviada nesta instância), então não há por que reservar aquele
        // espaço para uma tabela que ainda não existe. Isso NÃO é gravado
        // aqui — é só o padrão até a primeira busca, que recolhe a watchlist
        // sozinha (ver watchlist.js); uma preferência explícita (o usuário já
        // clicou no botão "«"/"»" alguma vez) sempre vale sobre esse padrão.
        var watchlistPref = localStorage.getItem("ro-market-tracker:watchlist-expandida");
        if (watchlistPref === "1" || watchlistPref === null) {
          document.documentElement.dataset.watchlistExpandida = "1";
        }
      } catch (e) {}
    })();
  </script>
  <script src="/static/htmx.min.js"></script>
  <script src="/static/app.js" defer></script>
  <script src="/static/theme.js" defer></script>
  <script src="/static/watchlist.js" defer></script>
  <script src="/static/activity-bar.js" defer></script>
</head>
<body>
  {{/* Fora da .page e grudado no topo: quando o site limita as consultas,
       nada mais na tela funciona, e o aviso precisa continuar visível
       enquanto se rola a página. aria-live="polite" para o leitor de tela
       anunciar sem cortar o que estiver lendo. */}}
  <div id="suspension-banner" class="suspension-banner" role="status" aria-live="polite" hidden>
    <strong>O site limitou as consultas.</strong>
    <span id="suspension-detail">As buscas e a watchlist estão pausadas. O programa verifica sozinho de tempos em tempos e volta ao normal assim que o site liberar.</span>
  </div>

  <main class="page">
    <div class="page-header">
      <h1>RO Market Tracker</h1>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Alternar entre tema claro e escuro" title="Alternar tema">
        <svg class="icon-sun" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
        </svg>
      </button>
    </div>
    <p class="subtitle">Preços do mercado de comércio do Ragnarok Online LATAM</p>

    <form class="search-form" hx-get="/web/search" hx-target="#results" hx-swap="innerHTML" hx-indicator="#search-spinner">
      <select name="server" aria-label="Servidor">
        <option value="NIDHOGG" selected>NIDHOGG</option>
        <option value="FREYA">FREYA</option>
      </select>
      <input type="text" name="item" placeholder="Nome do item" aria-label="Nome do item" required autofocus>
      <button type="submit" class="search-button" aria-label="Buscar">
        <svg viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
        </svg>
        <span id="search-spinner" class="htmx-indicator spinner" aria-hidden="true"></span>
      </button>

      {{/* Desmarcados por padrão, e sem hx-trigger="change": cada um custa uma
           consulta ao site POR ANÚNCIO encontrado, então marcar a caixa não
           pode, sozinho, disparar a varredura — ela sai junto da próxima
           busca. Ver internal/web/bonus.go. */}}
      <div class="search-options">
        <label class="search-option">
          <input type="checkbox" name="refine" value="1">
          Verificar refino
        </label>
        <label class="search-option">
          <input type="checkbox" name="bonus" value="1">
          Verificar bônus aleatórios
        </label>
        {{/* Aparece e some só por CSS (ver .search-options:has(...)), e não
             por JS: o navegador restaura o estado dos checkboxes ao
             recarregar a página, e um JS em DOMContentLoaded deixaria um
             instante com a caixa marcada e o aviso escondido. É o mesmo
             motivo pelo qual os ícones do tema são resolvidos em CSS.

             role="note", e não "alert": o leitor de tela não deve interromper
             a leitura a cada clique no checkbox. */}}
        <p class="search-warning" role="note">
          Verificar refino ou bônus aleatórios custa uma consulta a mais ao
          site por anúncio encontrado (duas, se as duas caixas estiverem
          marcadas). Use somente quando for realmente necessário: quanto
          maior o número de consultas, maior o risco de o site da GnJoy
          bloquear as suas por alguns minutos.
        </p>
      </div>
    </form>

    <div class="results-column">
      <div id="results"></div>
    </div>

    <aside class="watchlist-panel" aria-label="Watchlist">
      <div class="watchlist-header">
        <h2>Watchlist</h2>
        <div id="watchlist-timer" class="watchlist-timer" title="Tempo até a próxima checagem automática de preços">
          <span id="watchlist-countdown">--:--</span>
          <button type="button" id="watchlist-refresh-now" aria-label="Atualizar agora e reiniciar o cronômetro" title="Atualizar agora">↻</button>
          <button type="button" id="watchlist-expand" aria-expanded="false" aria-label="Expandir a watchlist sobre a área de resultados" title="Expandir">«</button>
        </div>
      </div>
      <ul id="watchlist-list" class="watchlist-list"></ul>
      <p id="watchlist-empty" class="empty">Nenhum item na watchlist.</p>
    </aside>
  </main>

  <div id="activity-bar" class="activity-bar" role="button" tabindex="0" aria-expanded="false" aria-label="Barra de atividades — clique para expandir ou recolher">
    <ul id="activity-history" class="activity-history"></ul>
    <div class="activity-bar-header">
      <span class="activity-line">
        <span id="activity-current-label">Nenhuma atividade ainda.</span>
        <span id="activity-spinner" class="spinner" hidden aria-hidden="true"></span>
      </span>
      <span id="activity-current-time" class="activity-time"></span>
      <span class="activity-bar-icon" aria-hidden="true">▲</span>
    </div>
  </div>

  {{/* Canto discreto de propósito: pointer-events:none no CSS tira até o
       cursor de "isto é clicável" da versão em si — só o link de
       atualização (que o JS revela) volta a responder ao mouse. Fica acima
       do "activity-bar" e longe do "toast-container" (que usa o canto
       oposto), os dois únicos outros elementos fixos da tela. */}}
  <div id="version-badge" class="version-badge" title="Versão em uso">
    <span id="version-current">{{.Version}}</span>
    <a id="version-update-link" class="version-update-link"
        href="https://github.com/lbcosta/ro-market-tracker/releases/latest"
        target="_blank" rel="noopener" hidden>· atualização disponível</a>
  </div>
  <script src="/static/version.js" defer></script>
</body>
</html>
