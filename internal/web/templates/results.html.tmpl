{{if .Error}}
<p class="error">{{.Error}}</p>
{{else if not .Items}}
{{/* A busca sem resultados não chega aqui: ela cai para o histórico de
     preços do item (history.html.tmpl). Este ramo é só a garantia de que
     uma lista vazia nunca vire uma tabela com cabeçalho e nenhuma linha. */}}
<p class="empty">Nenhum resultado encontrado.</p>
{{else}}
<div class="results-header">
  <h2 class="results-title">Resultados de {{.Query}}</h2>
</div>
{{/* A busca deu certo e o que está na tabela é verdadeiro — só ficou
     incompleto. Por isso um aviso, e não a mensagem de erro que substituiria
     a tabela inteira. */}}
{{if .Aviso}}<p class="results-aviso" role="note">{{.Aviso}}</p>{{end}}
<table class="results-table">
  <thead>
    <tr>
      <th>Item</th>
      <th aria-sort="{{if eq .SortBy "price"}}{{if eq .SortDir "desc"}}descending{{else}}ascending{{end}}{{else}}none{{end}}">
        <a href="{{.PriceSortURL}}" hx-get="{{.PriceSortURL}}" hx-target="#results" hx-swap="innerHTML" hx-indicator="#search-spinner" class="sort-link">Preço{{.PriceArrow}}</a>
      </th>
      <th>Loja</th>
      <th aria-sort="{{if eq .SortBy "qty"}}{{if eq .SortDir "desc"}}descending{{else}}ascending{{end}}{{else}}none{{end}}">
        <a href="{{.QtySortURL}}" hx-get="{{.QtySortURL}}" hx-target="#results" hx-swap="innerHTML" hx-indicator="#search-spinner" class="sort-link">Qtd{{.QtyArrow}}</a>
      </th>
    </tr>
  </thead>
  <tbody>
    {{range .Groups}}
    <tr class="item-group-row">
      <td colspan="4">
        <div class="item-group-header">
          <span class="item-group-label">
            {{/* O "if" não é zelo: com src="" o navegador requisita a URL do
                 documento atual, e cada seção da tabela viraria um GET a mais
                 na própria página. O "onerror" cobre o item sem imagem no
                 banco e a CDN fora do ar — sem ele sobraria o ícone quebrado
                 empurrando o nome de lado. */}}
            {{if .ImgPath}}<img class="item-icon" src="{{.ImgPath}}" alt="" width="24" height="24"
                loading="lazy" decoding="async" referrerpolicy="no-referrer"
                onerror="this.remove()">{{end}}
            <span class="item-group-name">{{.ItemName}}</span>
            {{if $.GroupByRefine}}
              {{if not .RefineKnown}}<span class="group-chip group-chip-desconhecido">refino não verificado</span>
              {{else if gt .Refine 0}}<span class="refine-badge">+{{.Refine}}</span>{{end}}
            {{end}}
            {{if $.GroupByBonus}}
              {{if not .BonusKnown}}<span class="group-chip group-chip-desconhecido">bônus não verificados</span>
              {{else if .Bonus}}{{range .Bonus}}<span class="bonus-chip">{{.}}</span>{{end}}
              {{else}}<span class="group-chip">sem bônus</span>{{end}}
            {{end}}
          </span>
          {{/* data-refine só quando a seção de fato representa UM refino: é
               ele que a watchlist passa a acompanhar, em vez de "o mais
               barato de qualquer refino". Bônus não têm equivalente — o
               endpoint de preço não filtra por eles, e filtrar custaria uma
               consulta de detalhe por candidato a cada consulta do item. */}}
          <button type="button" class="watchlist-button"
              data-server="{{$.Server}}" data-item-id="{{.ItemID}}" data-item-name="{{.ItemName}}"
              data-search-name="{{.SearchName}}"
              {{if and $.GroupByRefine .RefineKnown}}data-refine="{{.Refine}}"{{end}}
              onclick="addToWatchlist(this)">+ Watchlist</button>
        </div>
      </td>
    </tr>
    {{range .Items}}
    <tr class="item-row" title="Clique para expandir ou recolher os detalhes"
        hx-get="/web/shops/{{.SvrId}}/{{.MapId}}/{{.SSI}}/expand"
        hx-target="#detail-{{.SSI}}" hx-swap="innerHTML" hx-trigger="click once"
        hx-indicator="#spinner-{{.SSI}}"
        onclick="toggleRow(this)">
      <td><span class="expand-icon" aria-hidden="true">▸</span>{{.DisplayName}}</td>
      <td>{{formatMoney .ItemPrice}}</td>
      <td>{{.StoreName}}</td>
      <td>{{.ItemCnt}}</td>
    </tr>
    <tr class="detail-row">
      <td colspan="4">
        <div id="detail-{{.SSI}}" class="detail-cell">
          <span id="spinner-{{.SSI}}" class="htmx-indicator spinner"></span>
        </div>
      </td>
    </tr>
    {{end}}
    {{end}}
  </tbody>
</table>

{{/* As outras versões do item (a "+13" quando só a "+7" está à venda) custam
     outra consulta ao site, então só são buscadas se o usuário pedir — ver
     internal/web/variants.go. */}}
<div class="variants-block">
  <button type="button" class="variants-button"
      hx-get="{{.VariantsURL}}" hx-target="#variants" hx-swap="innerHTML"
      hx-indicator="#variants-spinner" hx-disabled-elt="this">
    Ver outras versões deste item fora do mercado
    <span id="variants-spinner" class="htmx-indicator spinner" aria-hidden="true"></span>
  </button>
  <div id="variants"></div>
</div>
{{end}}
