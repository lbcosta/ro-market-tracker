{{/* O corpo da aba Watchlist. Serve para os dois caminhos: embutido no
     documento completo (watchlist.html.tmpl) e sozinho, como resposta da
     troca de aba (ver Handler.Watchlist). Um HTML só para os dois casos —
     é o que garante que abrir a URL direto e chegar pelo menu deem a mesma
     tela. */}}
{{define "watchlist-body"}}
<div class="page-body page-body--watchlist">
  <form class="search-form" hx-get="/web/search" hx-target="#results" hx-swap="innerHTML" hx-indicator="#search-spinner">
    <select name="server" aria-label="Servidor">
      <option value="NIDHOGG" selected>NIDHOGG</option>
      <option value="FREYA">FREYA</option>
    </select>
    <input type="text" name="item" placeholder="Nome do item" aria-label="Nome do item" required autofocus>
    <button type="submit" class="search-button" aria-label="Buscar">
      <svg viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
      </svg>
      <span id="search-spinner" class="htmx-indicator spinner" aria-hidden="true"></span>
    </button>

    {{/* Desmarcados por padrão, e sem hx-trigger="change": cada um custa uma
         consulta ao site POR ANÚNCIO encontrado, então marcar a caixa não
         pode, sozinho, disparar a varredura — ela sai junto da próxima
         busca. Ver internal/web/bonus.go. */}}
    <div class="search-options">
      <label class="search-option">
        <input type="checkbox" name="refine" value="1">
        Verificar refino
      </label>
      <label class="search-option">
        <input type="checkbox" name="bonus" value="1">
        Verificar bônus aleatórios
      </label>
      {{/* Aparece e some só por CSS (ver .search-options:has(...)), e não
           por JS: o navegador restaura o estado dos checkboxes ao
           recarregar a página, e um JS em DOMContentLoaded deixaria um
           instante com a caixa marcada e o aviso escondido. É o mesmo
           motivo pelo qual os ícones do tema são resolvidos em CSS.

           role="note", e não "alert": o leitor de tela não deve interromper
           a leitura a cada clique no checkbox. */}}
      <p class="search-warning" role="note">
        Verificar refino ou bônus aleatórios custa uma consulta a mais ao
        site por anúncio encontrado (duas, se as duas caixas estiverem
        marcadas). Use somente quando for realmente necessário: quanto
        maior o número de consultas, maior o risco de o site da GnJoy
        bloquear as suas por alguns minutos.
      </p>
    </div>
  </form>

  <div class="results-column">
    <div id="results"></div>
  </div>

  <aside class="watchlist-panel" aria-label="Watchlist">
    <div class="watchlist-header">
      <h2>Watchlist</h2>
      {{/* Os atributos data-cronometro-do-rodizio* são como o monitor acha
           este relógio: ele é do rodízio inteiro, não da watchlist, e
           qualquer tela pode mostrá-lo sem o monitor conhecer ids de página
           (ver static/monitor.js). */}}
      <div id="watchlist-timer" class="watchlist-timer" data-cronometro-do-rodizio-titulo
        title="Tempo até a próxima checagem automática de preços">
        <span id="watchlist-countdown" data-cronometro-do-rodizio>--:--</span>
        <button type="button" id="watchlist-expand" aria-expanded="false" aria-label="Expandir a watchlist sobre a área de resultados" title="Expandir">«</button>
      </div>
    </div>
    <ul id="watchlist-list" class="watchlist-list"></ul>
    <p id="watchlist-empty" class="empty">Nenhum item na watchlist.</p>
  </aside>
</div>
{{/* Só no fragmento: no documento completo o menu já está no cabeçalho, e
     mandá-lo de novo aqui o desenharia duas vezes. Ver o comentário do
     {{define "menu"}} em layout.html.tmpl. */}}
{{if .Fragment}}{{template "menu" .}}{{end}}
{{end}}
